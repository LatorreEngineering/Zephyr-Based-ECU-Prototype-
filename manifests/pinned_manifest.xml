#!/usr/bin/env bash
set -euo pipefail

# -------------------------------------------------------------------
# Patches pinned_manifest.xml with a specific Zephyr SHA
# -------------------------------------------------------------------

MANIFEST_FILE="manifests/pinned_manifest.xml"

# Fetch SHA from environment variable or file
if [ -n "${ZEPHYR_SHA:-}" ]; then
    SHA="$ZEPHYR_SHA"
elif [ -f zephyr_sha.txt ]; then
    SHA=$(<zephyr_sha.txt)
else
    echo "[ERROR] Zephyr SHA not provided. Set ZEPHYR_SHA or create zephyr_sha.txt"
    exit 1
fi

# Remove all whitespace, newlines, and carriage returns
SHA=$(echo "$SHA" | tr -d '[:space:]\r\n')

# Fail if SHA is empty
if [ -z "$SHA" ]; then
    echo "[ERROR] Zephyr SHA is empty after trimming"
    exit 1
fi

# Verify manifest exists
if [ ! -f "$MANIFEST_FILE" ]; then
    echo "[ERROR] Manifest file not found: $MANIFEST_FILE"
    exit 1
fi

echo "[INFO] Patching $MANIFEST_FILE with Zephyr SHA: $SHA"

# Escape & characters in SHA for sed
SAFE_SHA=$(printf '%s' "$SHA" | sed 's/[&]/\\&/g')

# Patch manifest safely using @ as delimiter
sed -i "s@revision=\"[^\"]*\"@revision=\"$SAFE_SHA\"@" "$MANIFEST_FILE"

echo "[INFO] Patched $MANIFEST_FILE successfully"



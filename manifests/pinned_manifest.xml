#!/bin/bash
set -e

# Ensure zephyr_sha.txt exists
if [ ! -f zephyr_sha.txt ]; then
  echo "[ERROR] zephyr_sha.txt not found. Run the SHA fetch step first."
  exit 1
fi

ZEHPYR_SHA=$(cat zephyr_sha.txt)
MANIFEST_FILE="manifests/pinned_manifest.xml"

if [ ! -f "$MANIFEST_FILE" ]; then
  echo "[ERROR] $MANIFEST_FILE not found!"
  exit 1
fi

echo "[INFO] Patching pinned_manifest.xml with Zephyr SHA: $ZEHPYR_SHA"

# Replace any Zephyr revision in the manifest with the exact SHA
sed -i "s|revision=\"[^\"]*\"|revision=\"$ZEHPYR_SHA\"|" "$MANIFEST_FILE"

echo "[INFO] patched $MANIFEST_FILE successfully"
